<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_default"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_weather_glass">

                <TextView
                    android:id="@+id/tv_weather_dialog_header_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="天气"
                    android:gravity="center"
                    android:text="🌤️"
                    android:textSize="20sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="天气预报"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_weather_dialog_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="实时天气"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_close_weather"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="关闭天气"
                android:gravity="center"
                android:text="×"
                android:textColor="@android:color/white"
                android:textSize="27sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_weather_dialog_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="南京"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_weather_dialog_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="☀️"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/tv_weather_dialog_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:includeFontPadding="false"
            android:text="--°"
            android:textColor="@android:color/white"
            android:textSize="62sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_weather_dialog_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="正在获取实时天气"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_weather_glass"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_weather_dialog_feels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="体感\n--°"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#55FFFFFF" />

            <TextView
                android:id="@+id/tv_weather_dialog_humidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="湿度\n--%"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#55FFFFFF" />

            <TextView
                android:id="@+id/tv_weather_dialog_wind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="风力\n--"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:background="#55FFFFFF" />

            <TextView
                android:id="@+id/tv_weather_dialog_aqi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="空气\n--"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="未来三天"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_weather_forecast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_weather_glass"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />
    </LinearLayout>
</ScrollView>
