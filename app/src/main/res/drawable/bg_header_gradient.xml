<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF4F4F6" />
        </shape>
    </item>

    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="top|left">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFE3C7"
                android:gradientRadius="170dp"
                android:startColor="#52FFE3C7"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="top|right">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFD9D2"
                android:gradientRadius="160dp"
                android:startColor="#4DFFD9D2"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:width="420dp"
        android:height="220dp"
        android:gravity="bottom|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFDFC2"
                android:gradientRadius="180dp"
                android:startColor="#40FFDFC2"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
